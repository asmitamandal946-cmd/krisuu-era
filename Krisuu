<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Krisuu ERA — Krisuu Top-Up Emperor</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:Arial,Helvetica,sans-serif}
html{scroll-behavior:smooth}
body{background:#08090d;color:#fff;min-height:100vh}
header{background:#11131a;border-bottom:1px solid #242733;padding:18px 6%;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100}
.logo{font-size:24px;font-weight:900;color:#ffb400}.logo span{color:#fff}
nav a{color:#ddd;text-decoration:none;margin-left:22px;font-size:14px}
nav a:hover{color:#ffb400}
.hero{text-align:center;padding:70px 20px 50px;background:radial-gradient(circle at center,#2a2105 0%,#08090d 55%)}
.hero h1{font-size:clamp(35px,7vw,65px);font-weight:900;margin-bottom:15px}.hero h1 span{color:#ffb400}
.hero p{color:#aaa;max-width:650px;margin:auto;line-height:1.6}
.hero-btn,.channel-btn{display:inline-block;margin-top:28px;padding:14px 28px;border-radius:10px;background:#ffb400;color:#111;text-decoration:none;font-weight:800}
.container{width:90%;max-width:1100px;margin:auto}
.section-title{text-align:center;margin:45px 0 25px;font-size:28px}
.packages{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:18px}
.package{background:#12151c;border:1px solid #292d38;border-radius:15px;padding:25px 15px;text-align:center;cursor:pointer;transition:.25s}
.package:hover{transform:translateY(-5px);border-color:#ffb400}.package.selected{border:2px solid #ffb400;background:#1b1910}
.diamond{font-size:38px;margin-bottom:12px}.package h3{margin-bottom:8px}.package .price{color:#ffb400;font-size:21px;font-weight:bold}
.order-box{margin:45px auto;max-width:600px;background:#11131a;border:1px solid #292d38;border-radius:18px;padding:28px}
.order-box h2{margin-bottom:20px;text-align:center}
.step{background:#191c24;padding:20px;border-radius:12px;margin-bottom:18px}.step h3{margin-bottom:15px;color:#ffb400}
label{display:block;margin:14px 0 7px;color:#ccc;font-size:14px}
input:not([type=checkbox]),select{width:100%;padding:14px;border-radius:9px;border:1px solid #303440;background:#08090d;color:white;outline:none}
input:focus,select:focus{border-color:#ffb400}
.summary{margin-top:15px;background:#0d0f14;border-radius:10px;padding:18px}
.summary-row{display:flex;justify-content:space-between;margin:8px 0;color:#ccc}.total{color:#ffb400;font-size:22px;font-weight:bold}
.payment-card{background:#0d0f14;border:1px solid #303440;border-radius:10px;padding:18px;line-height:1.8}
.payment-name,.payment-number{margin-top:8px}.warning{color:#ffcc66;font-size:13px;margin-top:12px}
.qr-wrap{text-align:center;margin:18px 0 5px}.qr-wrap img{width:min(280px,100%);height:auto;border-radius:12px;background:#fff;padding:8px}
.qr-caption{color:#aaa;font-size:13px;margin-top:8px}
.order-btn{width:100%;margin-top:20px;padding:15px;border:none;border-radius:10px;background:#25d366;color:white;font-size:16px;font-weight:800;cursor:pointer}
.order-btn:hover{background:#1ebe5d}
.success-box{display:none;text-align:center;padding:30px;background:#102015;border:1px solid #2ecc71;border-radius:15px}
.success-icon{width:60px;height:60px;margin:auto auto 15px;border-radius:50%;background:#2ecc71;color:white;display:flex;align-items:center;justify-content:center;font-size:35px;font-weight:bold}
.order-id{margin:18px 0;padding:12px;background:#08090d;border-radius:8px;color:#ffb400}.small{color:#999;font-size:13px;line-height:1.5}
.channel-btn{background:#25d366;color:#fff;margin-top:18px}
.features{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px;margin-bottom:60px}
.feature{padding:25px;text-align:center;background:#11131a;border:1px solid #292d38;border-radius:15px}
.feature-icon{font-size:32px;margin-bottom:12px}.feature p{color:#999;margin-top:8px;line-height:1.5;font-size:14px}
footer{border-top:1px solid #242733;background:#0d0f14;text-align:center;padding:30px 15px;color:#777;font-size:13px}
footer a{color:#ffb400;text-decoration:none}
@media(max-width:600px){header{padding:15px 5%}nav a{margin-left:10px;font-size:12px}.hero{padding-top:50px}.order-box{padding:20px}}
</style>

<style>
/* Premium animated storefront */
body::before{
  content:"";position:fixed;inset:0;pointer-events:none;z-index:-1;
  background:
    radial-gradient(circle at 15% 20%,rgba(255,180,0,.08),transparent 28%),
    radial-gradient(circle at 85% 75%,rgba(0,180,255,.06),transparent 30%);
}
header{backdrop-filter:blur(14px);background:rgba(17,19,26,.82);box-shadow:0 8px 30px rgba(0,0,0,.2)}
.logo{animation:logoGlow 2.5s ease-in-out infinite}
.hero{position:relative;overflow:hidden}
.hero::before,.hero::after{
  content:"";position:absolute;border-radius:50%;filter:blur(2px);opacity:.35;pointer-events:none;
  border:1px solid rgba(255,180,0,.35);
}
.hero::before{width:280px;height:280px;left:-120px;top:-100px;animation:floatOrb 7s ease-in-out infinite}
.hero::after{width:360px;height:360px;right:-170px;bottom:-180px;animation:floatOrb 9s ease-in-out infinite reverse}
.hero h1{animation:fadeUp .8s ease both}
.hero p{animation:fadeUp 1s .12s ease both}
.hero-btn{position:relative;overflow:hidden;box-shadow:0 8px 30px rgba(255,180,0,.18);animation:fadeUp 1s .2s ease both}
.hero-btn::after,.order-btn::after{
  content:"";position:absolute;top:0;left:-120%;width:70%;height:100%;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.35),transparent);
  transform:skewX(-20deg);animation:shine 3.2s infinite;
}
.package{position:relative;overflow:hidden;box-shadow:0 10px 30px rgba(0,0,0,.15)}
.package::before{
  content:"";position:absolute;inset:-2px;border-radius:15px;
  background:linear-gradient(120deg,transparent 30%,rgba(255,180,0,.18),transparent 70%);
  transform:translateX(-100%);transition:.5s;pointer-events:none;
}
.package:hover::before{transform:translateX(100%)}
.package.selected{box-shadow:0 0 0 1px rgba(255,180,0,.15),0 12px 40px rgba(255,180,0,.12)}
.diamond{animation:diamondFloat 2.5s ease-in-out infinite}
.step{box-shadow:0 8px 25px rgba(0,0,0,.12);transition:transform .25s,box-shadow .25s}
.step:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(0,0,0,.18)}
.payment-card{position:relative;overflow:hidden}
.qr-wrap img{box-shadow:0 0 0 3px rgba(255,255,255,.04),0 15px 45px rgba(0,0,0,.35);transition:transform .3s}
.qr-wrap img:hover{transform:scale(1.025)}
.order-btn,.channel-btn{position:relative;overflow:hidden;transition:transform .2s,filter .2s}
.order-btn:hover,.channel-btn:hover{transform:translateY(-2px);filter:brightness(1.06)}
.success-box{animation:successPop .5s ease both}
.success-icon{animation:successPulse 1.8s ease-in-out infinite}
.feature{transition:transform .25s,border-color .25s,box-shadow .25s}
.feature:hover{transform:translateY(-5px);border-color:#3a3f4c;box-shadow:0 12px 30px rgba(0,0,0,.18)}
.feature-icon{animation:featureFloat 3s ease-in-out infinite}
@keyframes fadeUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
@keyframes logoGlow{0%,100%{text-shadow:0 0 0 rgba(255,180,0,0)}50%{text-shadow:0 0 18px rgba(255,180,0,.35)}}
@keyframes floatOrb{0%,100%{transform:translate(0,0)}50%{transform:translate(25px,18px)}}
@keyframes shine{0%{left:-120%}55%,100%{left:150%}}
@keyframes diamondFloat{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-5px) rotate(3deg)}}
@keyframes successPop{from{opacity:0;transform:scale(.97) translateY(10px)}to{opacity:1;transform:scale(1) translateY(0)}}
@keyframes successPulse{0%,100%{box-shadow:0 0 0 0 rgba(46,204,113,.15)}50%{box-shadow:0 0 0 12px rgba(46,204,113,0)}}
@keyframes featureFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none!important;transition:none!important}
}
</style>

</head>
<body>

<header>
<div class="logo">💎 Krisuu <span>ERA</span></div>
<nav><a href="#packages">Packages</a><a href="#order">Order</a></nav>
</header>

<section class="hero">
<h1>Krisuu <span>Top-Up Emperor</span></h1>
<p>Choose diamonds or a membership package, enter your Player UID, and submit your order.</p>
<a href="#packages" class="hero-btn">Buy Now</a>
</section>

<main class="container">
<h2 class="section-title" id="packages">💎 Select Package</h2>
<div class="packages">
<div class="package" data-name="100 Diamonds" data-diamonds="100" data-price="120"><div class="diamond">💎</div><h3>100 Diamonds</h3><div class="price">Rs. 120</div></div>
<div class="package" data-name="310 Diamonds" data-diamonds="310" data-price="350"><div class="diamond">💎</div><h3>310 Diamonds</h3><div class="price">Rs. 350</div></div>
<div class="package" data-name="520 Diamonds" data-diamonds="520" data-price="580"><div class="diamond">💎</div><h3>520 Diamonds</h3><div class="price">Rs. 580</div></div>
<div class="package" data-name="1060 Diamonds" data-diamonds="1060" data-price="1150"><div class="diamond">💎</div><h3>1060 Diamonds</h3><div class="price">Rs. 1,150</div></div>
<div class="package" data-name="2180 Diamonds" data-diamonds="2180" data-price="2200"><div class="diamond">💎</div><h3>2180 Diamonds</h3><div class="price">Rs. 2,200</div></div>
<div class="package" data-name="5600 Diamonds" data-diamonds="5600" data-price="5500"><div class="diamond">💎</div><h3>5600 Diamonds</h3><div class="price">Rs. 5,500</div></div>
<div class="package" data-name="Weekly Membership" data-diamonds="Weekly Membership" data-price="220"><div class="diamond">📅</div><h3>Weekly Membership</h3><div class="price">Rs. 220</div></div>
<div class="package" data-name="Monthly Membership" data-diamonds="Monthly Membership" data-price="1020"><div class="diamond">🗓️</div><h3>Monthly Membership</h3><div class="price">Rs. 1,020</div></div>
</div>

<div class="order-box" id="order">
<h2>🛒 Complete Your Order</h2>

<div class="step">
<h3>1. Player Details</h3>
<label for="uid">Free Fire Player UID</label>
<input type="text" id="uid" placeholder="Enter Player UID" maxlength="20">
<label for="server">Server / Region</label>
<select id="server"><option>Nepal</option><option>India</option><option>Bangladesh</option><option>Pakistan</option><option>Other</option></select>
</div>

<div class="step">
<h3>2. Order Summary</h3>
<div class="summary">
<div class="summary-row"><span>Package</span><span id="selectedDiamonds">Not selected</span></div>
<div class="summary-row"><span>Server</span><span id="selectedServer">Nepal</span></div>
<hr style="border-color:#303440;margin:14px 0">
<div class="summary-row"><span>Total</span><span class="total" id="totalPrice">Rs. 0</span></div>
</div>
</div>

<div class="step">
<h3>3. Payment</h3>
<div class="payment-card">
<p><strong>Pay using the QR code below</strong></p>
<div class="qr-wrap">
<img src="data:image/jpeg;base64," alt="Payment QR code">
<div class="qr-caption">Scan this QR with your supported payment app.</div>
</div>
<p class="payment-name">Account Name: Krisuu Era</p>
<p class="payment-number"><strong>Payment Number:</strong> +977 970-7352696</p>
<p class="warning">⚠️ Pay only to the official payment account. Never share your OTP, PIN, password, or card details.</p>
</div>
</div>

<div class="step">
<h3>4. Confirm Payment</h3>
<label for="transactionId">Payment Reference / Transaction ID</label>
<input type="text" id="transactionId" placeholder="Enter transaction/reference ID" maxlength="50">
<label style="display:flex;align-items:center;gap:8px">
<input type="checkbox" id="paymentConfirm" style="width:auto">
I confirm that I have completed the payment.
</label>
<button class="order-btn" onclick="confirmOrder()">✅ Submit Order via WhatsApp</button>
</div>

<div id="successBox" class="success-box">
<div class="success-icon">✓</div>
<h2>Order Submitted!</h2>
<p>Your order has been sent for confirmation.</p>
<div class="order-id">Order ID: <strong id="orderId"></strong></div>
<p class="small">Keep your Order ID and payment reference until your order is completed.</p>
<a class="channel-btn" href="https://whatsapp.com/channel/0029VbE1VYPEKyZ8Ntmc9o3Y" target="_blank" rel="noopener">Join Our WhatsApp Channel</a>
</div>
</div>

<h2 class="section-title">Why Choose Us?</h2>
<div class="features">
<div class="feature"><div class="feature-icon">⚡</div><h3>Fast Service</h3><p>Orders can be processed quickly after payment confirmation.</p></div>
<div class="feature"><div class="feature-icon">🔒</div><h3>UID Only</h3><p>Never ask customers for their game password or login credentials.</p></div>
<div class="feature"><div class="feature-icon">💬</div><h3>Support</h3><p>Customers can contact support regarding their order.</p></div>
</div>
</main>

<footer>
© 2026 Krisuu ERA. All rights reserved.<br><br>
<a href="https://whatsapp.com/channel/0029VbE1VYPEKyZ8Ntmc9o3Y" target="_blank" rel="noopener">Join our WhatsApp Channel</a>
<br><br>
This website is an independent top-up storefront and is not affiliated with Garena unless officially authorized.
</footer>

<script>
let selectedPackage=null;

document.querySelectorAll(".package").forEach(pkg=>{
pkg.addEventListener("click",()=>{
document.querySelectorAll(".package").forEach(p=>p.classList.remove("selected"));
pkg.classList.add("selected");
selectedPackage={
name:pkg.dataset.name,
diamonds:pkg.dataset.diamonds,
price:pkg.dataset.price
};
document.getElementById("selectedDiamonds").textContent=selectedPackage.name;
document.getElementById("totalPrice").textContent="Rs. "+Number(selectedPackage.price).toLocaleString();
document.getElementById("order").scrollIntoView({behavior:"smooth",block:"center"});
});
});

document.getElementById("server").addEventListener("change",function(){
document.getElementById("selectedServer").textContent=this.value;
});

function generateOrderId(){
return "DZ-"+Math.floor(100000+Math.random()*900000);
}

function confirmOrder(){
const uid=document.getElementById("uid").value.trim();
const transactionId=document.getElementById("transactionId").value.trim();
const confirmed=document.getElementById("paymentConfirm").checked;

if(!selectedPackage){alert("Please select a package.");return;}
if(!/^[0-9]{5,20}$/.test(uid)){alert("Please enter a valid Player UID.");return;}
if(transactionId.length<4){alert("Please enter a payment reference / transaction ID.");return;}
if(!confirmed){alert("Please confirm that you completed the payment.");return;}

const orderId=generateOrderId();
const server=document.getElementById("server").value;
const price=Number(selectedPackage.price).toLocaleString();

const message=`💎 NEW FREE FIRE TOP-UP ORDER

Order ID: ${orderId}
Player UID: ${uid}
Server: ${server}
Package: ${selectedPackage.name}
Amount: Rs. ${price}
Payment Reference: ${transactionId}

Status: Payment submitted for verification.`;

const whatsappNumber="9779827673832";
const whatsappUrl="https://wa.me/"+whatsappNumber+"?text="+encodeURIComponent(message);

document.getElementById("orderId").textContent=orderId;
document.getElementById("successBox").style.display="block";

window.open(whatsappUrl,"_blank");

// Redirect to your WhatsApp Channel after the order message is opened.
setTimeout(()=>{
window.location.href="https://whatsapp.com/channel/0029VbE1VYPEKyZ8Ntmc9o3Y";
},4000);
}
</script>
</body>
</html>
